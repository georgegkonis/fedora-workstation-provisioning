#!/usr/bin/env python3
"""Merge selected XML components into versioned IDE files, leaving other components intact."""
import re
from pathlib import Path
import xml.etree.ElementTree as ET

source = Path({{ .chezmoi.sourceDir | quote }}) / ".chezmoitemplates/jetbrains"
target = Path({{ .chezmoi.destDir | quote }}) / ".config/JetBrains"


def latest(ide):
    """Newest existing versioned config directory, e.g. Rider2026.2, if the IDE has been launched."""
    pattern = re.compile(re.escape(ide) + r"([0-9]+(?:\.[0-9]+)*)")
    found = [(tuple(map(int, m[1].split("."))), path) for path in target.glob(ide + "[0-9]*")
             if (m := pattern.fullmatch(path.name))]
    return max(found)[1] if found else None


for source_ide in sorted(path for path in source.iterdir() if path.is_dir()):
    ide = source_ide.name
    config_dir = latest(ide)
    if config_dir is None:
        continue
    options = config_dir / "options"
    for original in (source / ide / "options").glob("*.xml"):
        path = options / original.name
        owned = ET.parse(original).getroot()
        parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True))
        existing = ET.fromstring(path.read_text(), parser=parser) if path.exists() else ET.Element("application")
        names = {component.get("name") for component in owned}
        for component in list(existing):
            if component.tag == "component" and component.get("name") in names:
                existing.remove(component)
        existing.extend(owned)
        ET.indent(existing, space="  ")
        content = ET.tostring(existing, encoding="unicode") + "\n"
        if not path.exists() or path.read_text() != content:
            options.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
