# Shared interactive Bash/Zsh configuration.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
export EDITOR={{ if eq .workstation.preferences.editor "vscode" }}'code --wait'{{ else }}nvim{{ end }}
{{ if and .workstation.features.development .workstation.development.anaconda }}
if [ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ]; then
    . "$HOME/anaconda3/etc/profile.d/conda.sh"
fi
{{ end }}
{{ if .workstation.features.development }}
export MSBUILDDISABLENODEREUSE=1
alias claude='systemd-run --user --scope -q -p CPUQuota=400% -p MemoryHigh=6G -p MemoryMax=8G -p IOWeight=50 claude'
{{ end }}
