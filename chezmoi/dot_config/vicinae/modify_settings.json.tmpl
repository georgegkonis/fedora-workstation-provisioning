#!/usr/bin/env python3
"""Merge owned appearance keys while retaining Vicinae extension/user state."""
import json
import sys

original = sys.stdin.read()
settings = json.loads(original) if original.strip() else {}
managed = {
    "font": {"normal": {"family": "Adwaita Sans", "size": 11}},
    "theme": {
        "light": {"name": "libadwaita-light", "icon_theme": "Adwaita"},
        "dark": {"name": "libadwaita-dark", "icon_theme": "Adwaita"},
    },
}


def merge(target, source):
    for key, value in source.items():
        if isinstance(value, dict):
            if not isinstance(target.get(key), dict):
                target[key] = {}
            merge(target[key], value)
        else:
            target[key] = value


before = json.dumps(settings, sort_keys=True)
merge(settings, managed)
if before == json.dumps(settings, sort_keys=True) and original:
    sys.stdout.write(original)
else:
    sys.stdout.write(json.dumps(settings, indent=2) + "\n")
