# Managed workstation defaults; unrelated global settings live in ~/.gitconfig.
[init]
    defaultBranch = main
[fetch]
    prune = true
[core]
    autocrlf = input
{{ if .workstation.git.email }}
[user]
    name = {{ .workstation.git.name | quote }}
    email = {{ .workstation.git.email | quote }}
{{ end }}
{{ if and .workstation.features.development .workstation.development.git_credential_manager }}
[credential]
    helper = {{ .chezmoi.homeDir }}/.local/bin/git-credential-manager
    credentialStore = secretservice
    cacheOptions = --timeout 43200
{{ end }}
{{ if and .workstation.git.signing_key .workstation.apps.onepassword }}
[user]
    signingkey = {{ .workstation.git.signing_key | quote }}
[gpg]
    format = ssh
[gpg "ssh"]
    program = /opt/1Password/op-ssh-sign
[commit]
    gpgsign = true
{{ end }}
{{ if .workstation.features.work }}
[includeIf "gitdir:~/Projects/Work/"]
    path = ~/.config/git/work.gitconfig
{{ end }}
